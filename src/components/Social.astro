---
const { platform, username, href } = Astro.props;
const url = href || `https://www.${platform}.com/${username}`;
---
<a  target="_blank" 
    rel="noopener noreferrer" 
    href={url}
    class="text-gray-600 hover:text-purple-600 dark:hover:text-purple-200 transition colors"
    aria-label={platform}
>
<slot />
</a>


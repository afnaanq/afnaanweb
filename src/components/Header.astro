---
import Navigation from "./Navigation.astro";
import Switch from "./Switch.astro";
import Social from "./Social.astro";
import GithubLogo from "./GithubLogo.astro";
import LinkedInLogo from "./LinkedInLogo.astro";
import ResumeLogo from "./ResumeLogo.astro";
import Menu from "./Menu.astro";
---

<header class="header">
  <div class="header-container">
    <div class="logo-section">
      <a href="/" aria-label="Home" class="logo-link">
        <img src="/aqlogo.png" alt="Logo" class="logo-img" />
        <span class="logo-text">Afnaan Qasim</span>
      </a>
    </div>

    <nav class="nav-wrapper">
      <Navigation />
    </nav>

    <div class="header-right">
      <Social platform="github" username="afnaanq">
        <GithubLogo class="w-6 h-6" />
      </Social>

      <Social platform="linkedin" username="in/afnaanqasim/">
        <LinkedInLogo class="w-6 h-6" />
      </Social>

      <Social
        href="https://drive.google.com/file/d/10j8kiYMoqOOdy_p73OSGfYdV3BNjrQwY/view?usp=sharing"
      >
        <ResumeLogo class="w-6 h-6" />
      </Social>

      <Switch />

      <Menu />
    </div>
  </div>
</header>

<style>
  .header {
    width: 100%;
  }

  .header-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .logo-section {
    justify-self: start;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .logo-link:hover {
    opacity: 0.8;
  }

  .logo-img {
    width: 40px;
    height: 40px;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--gray-0);
    white-space: nowrap;
  }

  .nav-wrapper {
    justify-self: center;
    padding: 0.5rem 1.5rem;
    border: 1px solid var(--gray-800);
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(10px);
    border-radius: 50px;
    box-shadow: var(--shadow-sm);
  }

  html.dark .nav-wrapper {
    border-color: var(--gray-700);
  }

  .header-right {
    justify-self: end;
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  @media (max-width: 768px) {
    .header-container {
      grid-template-columns: auto 1fr auto;
      padding: 1rem;
      gap: 1rem;
    }

    .logo-section {
      justify-self: start; /* ADD THIS LINE */
    }

    .logo-text {
      display: none;
    }

    .nav-wrapper,
    .header-right > :not(:last-child):not(:nth-last-child(2)) {
      display: none;
    }

    .header-right {
      justify-self: end;
      gap: 1rem;
    }
  }
</style>

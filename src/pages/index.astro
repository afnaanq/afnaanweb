---
import BaseLayout from "../layouts/BaseLayout.astro";
import Greeting from "../components/Greeting";
import Expertise from "../components/Expertise.astro";
const pageTitle = "Afnaan Qasim | Neuro & Tech";

const features = [
  {
    title: "Data Science",
    subtitle: "AI and Deep Learning",
    description:
      "Gained experience in libraries such as PyTorch and TensorFlow, applying them to real-world data. Explored various algorithms and neural network architecture. ",
  },
  {
    title: "Development",
    subtitle: "Full Stack",
    description:
      "Currently learning React, TypeScript, Node.js to build scalable applications with modern frameworks and best practices to produce predictable, maintainable code.",
  },
  {
    title: "Neuroscience",
    subtitle: "Brain & Cognition",
    description:
      "Final year Neuroscience student at QMUL with year abroad at UCLA, exploring the intersection of neuroscience and technology. Dived deep into drug discovery and literature reviews.",
  },
  {
    title: "Co-Founder",
    subtitle: "The London Brownery",
    description:
      "Co-Founded The London Brownery and lead marketing campaigns and partnerships. Established loyal customer base and social media presence whilst winning 2x Great British Taste Awards.",
  },
];
const skills = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
      <circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
      <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>`,
    title: "Collaboration",
    description:
      "Leading cross-functional teams and building strong partnerships across technical and business domains.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>`,
    title: "Communication",
    description:
      "Translating complex technical concepts into clear insights for diverse audiences and stakeholders.",
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>`,
    title: "Problem Solving",
    description:
      "Analytical approach combining neuroscience insights with technical expertise to solve complex challenges.",
  },
];
---

<BaseLayout pageTitle={pageTitle}>
  <div class="page-wrapper">
    <main class="main-content">
      <section class="hero-grid">
        <div class="hero-text">
          <div class="eyebrow">Welcome to my website</div>

          <h1 class="display-title">
            <Greeting client:load messages={["Hey", "Hi", "Hello"]} />
          </h1>

          <p class="lead-text">
            Student at the intersection of science, tech and business. Based in
            London, UK.
          </p>

          <div class="expertise-section">
            <Expertise />
          </div>
        </div>

        <div class="hero-visual">
          <div class="floating-card">
            <div class="card-glow"></div>
            <img src="/SuitPic1.png" alt="Afnaan Qasim" class="hero-image" />
          </div>
        </div>
      </section>

      <section class="features-section">
        <h2 class="section-title">What I Do</h2>
        <div class="features-grid">
          {
            features.map((feature, index) => (
              <article class="feature-card" style={`--delay: ${index * 0.1}s`}>
                <div class="card-number">
                  {String(index + 1).padStart(2, "0")}
                </div>
                <h3 class="feature-title">{feature.title}</h3>
                <p class="feature-subtitle">{feature.subtitle}</p>
                <p class="feature-text">{feature.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="skills-section scroll-fade">
        <h2 class="section-title">Core Strengths</h2>
        <div class="skills-grid">
          {
            skills.map((skill) => (
              <div class="skill-card">
                <div class="skill-icon" set:html={skill.icon} />
                <h3 class="skill-title">{skill.title}</h3>
                <p class="skill-description">{skill.description}</p>
              </div>
            ))
          }
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .page-wrapper {
    width: 100%;
    min-height: 100vh;
    margin: 0;
    padding: 0;
    animation: pageLoadFade 0.6s ease-out;
  }

  @keyframes pageLoadFade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    min-height: 70vh;
    margin-bottom: 4rem;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: fadeInUp 0.8s ease-out backwards;
  }
  .hero-text > *:nth-child(1) {
    animation-delay: 0.1s;
  } /* eyebrow */
  .hero-text > *:nth-child(2) {
    animation-delay: 0.2s;
  } /* greeting */
  .hero-text > *:nth-child(3) {
    animation-delay: 0.3s;
  } /* lead text */
  .hero-text > *:nth-child(4) {
    animation-delay: 0.4s;
  } /* expertise eyebrows */

  .eyebrow {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--gradient-accent);
    color: var(--accent-text-over);
    border-radius: var(--radius-xl, 2rem);
    font-size: var(--text-sm);
    font-weight: 600;
    width: fit-content;
    box-shadow: var(--shadow-accent, var(--shadow-md));
  }

  .display-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: var(--gray-0);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0;
    transition: color var(--theme-transition);
  }

  .lead-text {
    font-size: var(--text-lg);
    color: var(--gray-300);
    line-height: 1.7;
    max-width: 600px;
    transition: color var(--theme-transition);
  }

  .expertise-section {
    margin-top: 1rem;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    animation: fadeInUp 0.8s ease-out 0.3s backwards;
  }

  .floating-card {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 3 / 4;
  }

  .card-glow {
    position: absolute;
    inset: -20px;
    background: var(--gradient-accent);
    border-radius: var(--radius-lg, 1.5rem);
    opacity: 0.2;
    filter: blur(40px);
    z-index: -1;
  }

  .hero-image {
    width: 100%;
    height: 80%;
    object-fit: cover;
    border-radius: var(--radius-lg, 1.5rem);
    box-shadow: var(--shadow-lg);
  }

  .features-section {
    margin: 8rem 0;
  }

  .section-title {
    text-align: center;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--gray-0);
    margin-bottom: 4rem;
    transition: color var(--theme-transition);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .feature-card {
    position: relative;
    background: var(--gray-999);
    padding: 2.5rem;
    border-radius: var(--radius-lg, 1.5rem);
    border: 1px solid var(--gray-800);
    transition: all 0.4s;
    animation: fadeInUp 0.6s ease-out backwards;
    animation-delay: var(--delay);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .feature-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-accent, var(--shadow-lg));
    border-color: var(--accent-regular);
  }

  html.dark .feature-card,
  :global(:root.theme-dark) .feature-card {
    background: var(--gray-900);
    border-color: var(--gray-700);
  }

  .card-number {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 3rem;
    font-weight: 900;
    color: var(--gray-800);
  }

  html.dark .card-number,
  :global(:root.theme-dark) .card-number {
    color: var(--gray-700);
  }

  .feature-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--gray-0);
    margin-bottom: 0.5rem;
    transition: color var(--theme-transition);
  }

  .feature-subtitle {
    font-size: var(--text-sm);
    color: var(--accent-regular);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  html.dark .feature-subtitle,
  :global(:root.theme-dark) .feature-subtitle {
    color: var(--accent-dark);
  }

  .feature-text {
    color: var(--gray-300);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    transition: color var(--theme-transition);
  }

  .card-arrow {
    font-size: 1.5rem;
    color: var(--accent-regular);
    transition: transform 0.3s;
  }

  html.dark .card-arrow,
  :global(:root.theme-dark) .card-arrow {
    color: var(--accent-dark);
  }

  .feature-card:hover .card-arrow {
    transform: translateX(8px);
  }

  .skills-section {
    margin: 8rem 0;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    padding: 3rem;
    background: var(--gray-999);
    border-radius: var(--radius-lg, 1.5rem);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--gray-800);
  }

  html.dark .skills-grid {
    background: var(--gray-900);
    border-color: var(--gray-700);
  }

  .skill-card {
    text-align: center;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .skill-card:hover {
    transform: translateY(-4px);
  }

  .skill-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1.5rem;
    color: var(--accent-regular);
    transition: color 0.3s ease;
  }

  html.dark .skill-icon {
    color: var(--accent-dark);
  }

  .skill-card:hover .skill-icon {
    transform: scale(1.1);
    transition: 0.3s;
  }

  .skill-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--gray-0);
    margin-bottom: 1rem;
    transition: color var(--theme-transition);
  }

  .skill-description {
    font-size: var(--text-sm);
    color: var(--gray-300);
    line-height: 1.6;
    transition: color var(--theme-transition);
  }

  
  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
      padding: 2rem;
    }
  }

  @media (max-width: 1024px) {
    .hero-grid {
      gap: 3rem;
    }

    .floating-card {
      max-width: 400px;
    }
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 2rem 1rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: auto;
    }
    .hero-text {
      text-align: center;
      align-items: center;
    }

    .lead-text {
      max-width: 100%;
    }
    .expertise-section {
      display: none;
    }

    .floating-card {
      max-width: 250px;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      padding: 2rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-value {
      font-size: 2.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card {
      animation: none;
    }
  }
</style>

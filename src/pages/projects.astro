---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Afnaan Qasim | Projects";

const projects = [
  {
    title: "AI Traffic Signal Optimisation",
    description: "Engineered a deep reinforcement learning system achieving 14% congestion reduction.",
    image: "/projects/traffic.jpg",
    tags: ["Machine Learning", "Python", "PyTorch", "Tech", "Technology"],
    link: "/projects/traffic-optimization"
  },
  {
    title: "The London Brownery",
    description: "Award-winning brownie business with 4M+ content views and Great Taste Awards",
    image: "/projects/brownery.jpg",
    tags: ["Business", "Marketing", "E-commerce"],
    link: "/projects/london-brownery"
  },
  {
    title: "Neuroscience Research",
    description: "Computational neuroscience analysis platform for behavioral data",
    image: "/projects/neuro.jpg",
    tags: ["Python", "Data Science", "Research"],
    link: "/projects/neuroscience"
  },
    {
    title: "This website you're currently on",
    description: "React and TypeScript application with real-time data analytics",
    image: "/projects/dashboard.jpg",
    tags: ["React", "TypeScript", "Node.js"],
    link: "/projects/dashboard"
  },
    {
    title: "AI Book Generator",
    description: "LLM-powered application for automated content generation",
    image: "/projects/bookgen.jpg",
    tags: ["AI", "TypeScript", "React"],
    link: "/projects/book-generator"
  },
];
---

<BaseLayout pageTitle={pageTitle}>
  <div class ='projects-page'>
    <div class="hero-section">
      <h1 class="page-title">My Projects</h1>
      <p class="page-subtitle">
        Here's some of my previous/current projects to get an idea of my experience.
      </p>
    </div>

    <div class="projects-grid">
      {projects.map((project, index) => (
        <a href={project.link} class="project-card" style={`--delay: ${index * 0.1}s`}>
          <div class="project-image">
            <img src={project.image} alt={project.title} />
            <div class="project-overlay"></div>
          </div>
          <div class="project-content">
            <span class="project-badge">{project.title}</span>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-description">{project.description}</p>
            <div class="project-tags">
              {project.tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>





<style>
  .projects-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 100vh;
  }

  /* Hero Section */
  .hero-section {
    text-align: left;
    margin-bottom: 4rem;
    padding: 2rem 0;
  }

  .page-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 900;
    color: var(--gray-0);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--gray-300);
    max-width: 600px;
    line-height: 1.6;
  }

  /* Masonry Grid Layout */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  /* Alternate heights for masonry effect */
  .project-card:nth-child(3n+1) {
    grid-row: span 1;
  }

  .project-card:nth-child(3n+2) {
    grid-row: span 2;
  }

  .project-card:nth-child(3n) {
    grid-row: span 1;
  }

  /* Project Card */
  .project-card {
    position: relative;
    background: var(--gray-999);
    border-radius: var(--radius-lg, 1.5rem);
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--gray-800);
    animation: fadeInUp 0.6s ease-out backwards;
    animation-delay: var(--delay);
    min-height: 300px;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hover effects removed */

  html.dark .project-card,
  :global(:root.theme-dark) .project-card {
    background: var(--gray-900);
    border-color: var(--gray-700);
  }

  /* Project Image */
  .project-image {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
    background: linear-gradient(135deg, var(--gradient-stop-1), var(--gradient-stop-2));
  }

  .project-card:nth-child(3n+2) .project-image {
    height: 350px;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  /* Image zoom removed */

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, 0.2) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Overlay hover removed */

  /* Project Content */
  .project-content {
    padding: 2rem;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.95);
    color: var(--accent-regular);
    border-radius: var(--radius-xl, 2rem);
    font-size: var(--text-sm);
    font-weight: 600;
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
    z-index: 10;
  }

  html.dark .project-badge,
  :global(:root.theme-dark) .project-badge {
    background: rgba(20, 25, 37, 0.95);
    color: var(--accent-dark);
  }

  .project-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--gray-0);
    margin: 0;
    transition: color 0.3s ease;
  }

  /* Title hover removed */

  .project-description {
    font-size: var(--text-base);
    color: var(--gray-300);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  /* Tags */
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background: var(--gray-800);
    color: var(--gray-300);
    border-radius: var(--radius-sm, 0.5rem);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  html.dark .tag,
  :global(:root.theme-dark) .tag {
    background: var(--gray-700);
    color: var(--gray-400);
  }

  /* Tag hover removed */

  /* Responsive */
  @media (max-width: 768px) {
    .projects-page {
      padding: 1rem;
    }

    .hero-section {
      text-align: center;
      margin-bottom: 2rem;
    }

    .page-subtitle {
      margin: 0 auto;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    /* Reset masonry on mobile */
    .project-card:nth-child(3n+1),
    .project-card:nth-child(3n+2),
    .project-card:nth-child(3n) {
      grid-row: span 1;
    }

    .project-image,
    .project-card:nth-child(3n+2) .project-image {
      height: 200px;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      animation: none;
    }
  }
</style>
</BaseLayout>


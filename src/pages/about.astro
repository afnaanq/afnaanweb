---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";
const pageTitle = "Afnaan Qasim | About";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="about-page">
    <div class="hero-section">
      <h1 class="page-title">About me</h1>
      <p class="page-subtitle">
        Here's pretty much everything about me. Enjoy.
      </p>
    </div>

    <div class="profile-section">
      <div class="profile-image-container">
        <img src="/YosemitePic.jpg" alt="Afnaan Qasim" class="profile-image" />
      </div>
    </div>

    <div class="content-sections">
      <section class="content-section">
        <h2 class="section-heading">Background</h2>
        <div class="section-content">
          <p>
            Growing up I've always tried to teach myself new things, primarily
            from resources like YouTube. Over the years I've taught myself
            programming languages/frameworks, marketing and even barbering.
            Turning these skills into business ventures has always been a
            passion of mine.
          </p>
          <p>
            Currently, I'm wrapping up my final year studying Neuroscience and
            was lucky enough to study abroad at UCLA (24-25) where I studied
            Neuroscience, Arabic and Python. Nowadays you'll find me writing up
            my dissertation whilst developing my programming skills by creating
            a full-stack app, and looking for roles where I can combine my
            technical, analytical and business background to drive meaningful
            outcomes.
          </p>
        </div>
      </section>

      <section class="content-section">
        <h2 class="section-heading">Education</h2>
        <div class="section-content">
          <div class="education-item">
            <h3>Queen Mary University of London</h3>
            <p class="education-degree">BSc (Hons) Neuroscience</p>
            <p class="education-date">2022 - 2026</p>
            <p>
              Focusing on computational, behavioural and cognitive neuroscience.
              Completed coursework in drug discovery, statistics, and
              experimental design.
            </p>
          </div>

          <div class="education-item">
            <h3>University of California, Los Angeles (UCLA)</h3>
            <p class="education-degree">Study Abroad Program</p>
            <p class="education-date">2024 - 2025</p>
            <p>
              Specialised in advanced neuroscience research methods and
              computational modeling. Collaborated with leading researchers in
              neuroimaging and machine learning.
            </p>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2 class="section-heading">Skills & Expertise</h2>
        <div class="section-content">
          <div class="skills-grid">
            <div class="skill-category">
              <h3>Programming</h3>
              <ul>
                <li>Python</li>
                <li>TypeScript / JavaScript</li>
                <li>C++</li>
                <li>R</li>
              </ul>
            </div>

            <div class="skill-category">
              <h3>Technologies</h3>
              <ul>
                <li>React + Astro</li>
                <li>Node.js</li>
                <li>PyTorch</li>
                <li>Pandas</li>
              </ul>
            </div>

            <div class="skill-category">
              <h3>Data & AI</h3>
              <ul>
                <li>Machine Learning</li>
                <li>Deep Learning</li>
                <li>Data Analytics</li>
                <li>Statistical Modeling</li>
              </ul>
            </div>

            <div class="skill-category">
              <h3>Business</h3>
              <ul>
                <li>Entrepreneurship</li>
                <li>Product Management</li>
                <li>Digital Marketing</li>
                <li>Operations</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="content-section">
        <h2 class="section-heading">Beyond Work</h2>
        <div class="section-content">
          <p>
            When I'm not coding or studying, you'll find me playing sports, at
            the gym or travelling. I previously played National League
            basketball and competed in the British Powerlifting Championship.
          </p>
          <p>
            I'm passionate about bridging the gap between neuroscience,
            artificial intelligence and business. I enjoy sharing knowledge
            through collaboration, always open to discussing new ideas, research
            opportunities, or potential collaborations.
          </p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 100vh;
  }

  .hero-section {
    text-align: center;
    margin-bottom: 4rem;
    padding: 2rem 0;
  }

  .page-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 900;
    color: var(--gray-0);
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: var(--gray-300);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .profile-section {
    display: flex;
    justify-content: center;
    margin-bottom: 4rem;
  }

  .profile-image-container {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg, 1.5rem);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content-sections {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .content-section {
    animation: fadeInUp 0.6s ease-out backwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .section-heading {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--gray-0);
    margin: 0 0 1.5rem 0;
  }

  .section-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-content p {
    font-size: var(--text-base);
    color: var(--gray-300);
    line-height: 1.8;
    margin: 0;
  }

  .education-item {
    padding: 1.5rem;
    background: var(--gray-999);
    border-radius: var(--radius-md, 1rem);
    border: 1px solid var(--gray-800);
    transition: all 0.3s ease;
  }

  .education-item:hover {
    border-color: var(--accent-regular);
    box-shadow: var(--shadow-md);
  }

  html.dark .education-item,
  :global(:root.theme-dark) .education-item {
    background: var(--gray-900);
    border-color: var(--gray-700);
  }

  .education-item h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--gray-0);
    margin: 0 0 0.5rem 0;
  }

  .education-degree {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--accent-regular);
    margin: 0 0 0.25rem 0 !important;
  }

  html.dark .education-degree,
  :global(:root.theme-dark) .education-degree {
    color: var(--accent-dark);
  }

  .education-date {
    font-size: var(--text-sm);
    color: var(--gray-400);
    margin: 0 0 1rem 0 !important;
    font-style: italic;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .skill-category {
    padding: 1.5rem;
    background: var(--gray-999);
    border-radius: var(--radius-md, 1rem);
    border: 1px solid var(--gray-800);
    transition: all 0.3s ease;
  }

  .skill-category:hover {
    border-color: var(--accent-regular);
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  html.dark .skill-category,
  :global(:root.theme-dark) .skill-category {
    background: var(--gray-900);
    border-color: var(--gray-700);
  }

  .skill-category h3 {
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--accent-regular);
    margin: 0 0 1rem 0;
  }

  html.dark .skill-category h3,
  :global(:root.theme-dark) .skill-category h3 {
    color: var(--accent-dark);
  }

  .skill-category ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .skill-category li {
    font-size: var(--text-sm);
    color: var(--gray-300);
    padding-left: 1.25rem;
    position: relative;
  }

  .skill-category li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent-regular);
  }

  html.dark .skill-category li::before,
  :global(:root.theme-dark) .skill-category li::before {
    color: var(--accent-dark);
  }

  @media (max-width: 768px) {
    .about-page {
      padding: 1rem;
    }

    .hero-section {
      margin-bottom: 2rem;
    }

    .profile-section {
      margin-bottom: 2rem;
    }

    .profile-image-container {
      max-width: 100%;
    }

    .content-sections {
      gap: 2.5rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-image-container,
    .content-section {
      animation: none;
    }
  }
</style>
